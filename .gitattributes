# Unreal binary assets go through Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# Source and config: normalise line endings
*.h text eol=crlf
*.cpp text eol=crlf
*.cs text eol=crlf
*.ini text eol=crlf
*.uproject text eol=crlf
*.uplugin text eol=crlf
*.md text
*.usf text eol=crlf
*.ush text eol=crlf
